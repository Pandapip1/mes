### The Windows _start for MesCC-compiled programs.
###
### Everything that is about Windows rather than about the compiler is in
### argv.M1 beside this file; what is left here is the calling convention.
###
### MesCC is cdecl: the caller pushes the arguments right to left and the
### callee opens with push %ebp / mov %esp,%ebp, so main finds argc at ebp+8.
### That is what these three pushes leave for it, and there is no frame to set
### up here -- main sets up its own.  __init_io takes no arguments and is
### called with them in place; it neither reads nor removes them, so main gets
### the same stack.  lib/linux/x86-mes-mescc/crt1.c does the same thing in C,
### which it can, because on Linux the values are on the stack already.

:_start
	call %resolve_all                           ; Find ntdll and resolve what we need from it
	call %__windows_argv                        ; ECX = argc, EBP = argv, EBX = envp

	push_ebx                                    ; envp, the third argument
	push_ebp                                    ; argv
	push_ecx                                    ; argc, the first, pushed last

	call %__init_io                             ; __stdin, __stdout, __stderr, environ
	call %main

	push_eax                                    ; ExitStatus = whatever main returned
	push_byte !-1                               ; ProcessHandle = NtCurrentProcess pseudo-handle
	call_[DWORD] &fn_exit                       ; Does not return
	hlt
